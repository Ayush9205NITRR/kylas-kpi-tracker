kylas-probe/
node_modules/
*.local.json
.env.local
.company-shape
logs/
.save-journal.json
.save-journal.json.tmp
dist/
apps/bd-ladder/node_modules
apps/bd-ladder/dist

# Cloudflare. .dev.vars holds the LOCAL Kylas key and Airtable token for
# `wrangler dev` — the same class of secret as .env.local, and never committed.
# .wrangler/ is the local D1 and cache state wrangler writes beside the config.
.dev.vars
.dev.vars.*
.wrangler/
screenshots/
# Recordings made by scripts/record-walkthrough.mjs. They are build output, not
# source — and on a live run they are frames of the real account, masked but
# still not something a public repo should carry.
walkthrough/

db/*.sqlite
db/*.sqlite-journal

# bulk-tag-companies.mjs: the canary verdict and the before-write snapshots (company data)
.bulk-tag-canary.json
bulk-tag-*.json

# Local output of scripts/offsite-month-source.py: company names and ids from a pipeline sheet.
offsite-source-*.csv
offsite-source-undo-*.json
reassign-snapshot-*.json
.allot-jobs.sqlite
# The two personas test-role-stress.mjs runs as. Separate files on purpose:
# one shared database would let the admin read the associate's queues and
# deals, and every scoping assertion in that suite would pass for the wrong
# reason.
.role-admin.sqlite
.role-bda.sqlite
db/.go-live.json
db/cutover-*.json
db/d1-import.sql
prune-undo-*.json
compact-undo-*.json
