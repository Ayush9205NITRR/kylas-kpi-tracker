# Copy this to .env.local and fill in the three values at the top.
#
#   cp .env.local.example .env.local
#   $EDITOR .env.local
#   source .env.local && node scripts/proxy.mjs
#
# .env.local is gitignored, which is the point: it holds the only two secrets
# in this project. A FRESH CLONE WILL NOT HAVE IT — that is not a broken
# checkout, it is the file never having left the machine that made it. If you
# have cloned again, look for the old one before issuing new keys:
#
#   find ~ -name .env.local -not -path '*/node_modules/*' 2>/dev/null
#
# `source` it in EVERY new terminal. It sets shell variables, not machine ones,
# so a second tab knows nothing about the first.

# ── required ──────────────────────────────────────────────────────────
# Kylas API key: app.kylas.io/setup/integrations/api-keys/list
export KYLAS_KEY=

# Airtable personal access token: airtable.com/create/tokens
# Scopes, on the base below:
#   data.records:read   data.records:write   schema.bases:read
#   schema.bases:write  — only for repair-base.mjs and create-base.mjs
export AIRTABLE_PAT=

# The base id, from its URL: airtable.com/appXXXXXXXXXXXXXX/...
export AIRTABLE_BASE=appEwJu0bleHh9b8t

# ── the research base ─────────────────────────────────────────────────
# The enrichment table the console reads beside its own research fields —
# Apollo link, funding, revenue, headcount, pipeline stage. Read-only:
# nothing is ever written back to it.
#
# THE PAT ABOVE MUST BE SCOPED TO THIS BASE TOO. It is a different base from
# the KPI one, so it is a separate tick box on airtable.com/create/tokens.
# If it is missing, the Research column says so — an empty panel would be
# indistinguishable from an account nobody has researched.
#
# Both default to the table Ayush linked on 2026-09-21, so normally neither
# needs setting. The ids come from the URL:
#   airtable.com/app55PsyRKqkf2CAQ/tbl2Jje9EBC4Cqydw/viw...
# export RESEARCH_BASE=app55PsyRKqkf2CAQ
# export RESEARCH_TABLE=tbl2Jje9EBC4Cqydw
#
# The column holding the Kylas company id is detected — by name first, then
# by matching values against ids already held. Set this only if the Research
# column reports that it could not find one.
# export RESEARCH_KEY_FIELD=Kylas Company ID
#
# Turn the whole thing off.
# export RESEARCH_OFF=1

# ── sharing one proxy across the team ─────────────────────────────────
# By default the proxy listens on 127.0.0.1 and uses the KYLAS_KEY above for
# everything. That is right for one-proxy-per-laptop, which is how this is
# installed today: the operating system is the access control, so there is
# nothing to authenticate.
#
# To run ONE proxy for everybody, both of these, together:
#
#   export PROXY_BIND=0.0.0.0        # or the Tailscale/LAN address
#   export PROXY_REQUIRE_KEY=1       # every caller sends their own Kylas key
#
# The proxy REFUSES to start if you set the first without the second, because
# that combination is an unauthenticated read/write door onto your CRM.
#
# With PROXY_REQUIRE_KEY=1 each associate pastes their own Kylas key into the
# console once (click the connection badge). That key is the credential AND the
# identity — "Me" on the dashboard, admin vs associate, and "Picked by…" stay
# per person. One key on the server for everybody makes eight associates into
# one, which removes the reason the KPI ladder exists.
#
# KYLAS_KEY can then be left empty: the server holds no Kylas credential at
# all, only the Airtable PAT.

# ── optional, with the defaults they already have ─────────────────────
# Uncomment only to change one.

# Who may see other people's numbers. Everyone else is scoped to their own.
# export ADMIN_EMAILS=you@enout.in
# export ADMIN_IDS=

# Where the console reads companies and contacts from. "airtable" is the
# default once a PAT and base are set, and is what you want — Kylas' own
# search stops at a result window that hides part of the account.
# export READ_SOURCE=airtable

# Another port, if 8787 is taken. Click the offline badge in the console to
# point it somewhere else.
# export PORT=8787

# Days of raw Call Log kept by rollup-calls.mjs. THIRTY, not the script's own
# default of 90: at 1,200 calls a day, 90 days is ~54,000 rows and Airtable
# counts records across the whole base.
# export CALL_RETAIN_DAYS=30

# cron's PATH is not your shell's. install-cron.sh pins this when it notices;
# set it yourself if you installed node afterwards.
# export NODE_BIN=/usr/local/bin/node
