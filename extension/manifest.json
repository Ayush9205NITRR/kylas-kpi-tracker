{
  "manifest_version": 3,
  "name": "Enout BD Call Console",
  "description": "Cold-call data-entry console overlaid on Kylas CRM.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version": "1.19.8",
  "permissions": [
    "storage",
    "identity",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://bd.enout.website/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://app.kylas.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open call console (Alt+Shift+E)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.kylas.io/*"
      ],
      "js": [
        "content/inject.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "console/*"
      ],
      "matches": [
        "https://app.kylas.io/*"
      ]
    }
  ],
  "commands": {
    "toggle-console": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open or close the call console"
    }
  }
}
